<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".home_page"
        android:background="@color/grey">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/vertical_guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.02"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/vertical_guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.98"/>

        <!-- Search Bar -->

        <SearchView
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/search_bg"
            android:inputType="text"
            android:queryHint="Search for a car here..."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/optionsButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/optionsButton"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"/>

        <ImageButton
            android:id="@+id/optionsButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/profile_bg"
            android:src="@drawable/baseline_person_2_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/searchBar" />


        <!-- Brands Section -->

        <TextView
            android:id="@+id/brandsTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:paddingStart="15dp"
            android:text="Brands"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintDimensionRatio="8:1"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintTop_toBottomOf="@id/searchBar" />

        <HorizontalScrollView
            android:id="@+id/brandScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/brandsTitle"
            app:layout_constraintDimensionRatio="2.5:1"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
            android:background="@drawable/search_bg"
            android:backgroundTint="@color/grey">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Example Brand -->
                <LinearLayout
                    android:id="@+id/landRoverLayout"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/brands_logo_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="fitCenter"
                        android:background="@color/white"
                        android:src="@drawable/landrover_logo" />

                    <TextView
                        android:layout_width="98dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="Land Rover"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/BmwLayout"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/brands_logo_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/bmw_icon_tp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="BMW"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/audiLayout"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/brands_logo_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/audi_logo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="Audi"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/volvoLayout"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/brands_logo_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/volvo_logo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="Volvo"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mercedesLayout"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/brands_logo_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/mercedes_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="Mercedes"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/brands_logo_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/brands_btn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="VIEW MORE"
                        android:textSize="20sp"
                        android:background="@drawable/brands_logo_background"/>

                </LinearLayout>


                <!-- Add more brand blocks dynamically -->
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/allBrandsButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="10dp"
            android:layout_marginHorizontal="5dp"
            android:text="View all Brands"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:fontFamily="serif-monospace"
            android:background="@drawable/brands_btn_bg"
            app:layout_constraintDimensionRatio="9:1"
            app:layout_constraintTop_toBottomOf="@id/brandScroll"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"/>

        <TextView
            android:id="@+id/featuredCars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:paddingStart="10dp"
            android:text="Featured Cars"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/allBrandsButton"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/CarCard1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="5dp"
            app:cardCornerRadius="10dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/featuredCars"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
            android:background="@color/grey">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/carcardConstraint1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                >

                <ImageView
                    android:id="@+id/carImage1"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_marginHorizontal="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bmw_ix1"
                    android:elevation="10dp"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint1"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint1"
                    app:layout_constraintTop_toTopOf="@id/carcardConstraint1"
                    />

                <TextView
                    android:id="@+id/carTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:text="BMW iX1 LWB"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint1"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint1"
                    app:layout_constraintTop_toBottomOf="@id/carImage1" />

                <TextView
                    android:id="@+id/carDetails1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="10dp"
                    android:text="Electric  |  Automatic  |  5-Seater"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="17sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/carTitle1" />

                <TextView
                    android:id="@+id/detailsBtn1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    android:text="Details"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:background="@drawable/button_bg"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint1"
                    app:layout_constraintTop_toBottomOf="@id/carDetails1"
                    app:layout_constraintStart_toEndOf="@id/rentNowBtn1"
                    />

                <TextView
                    android:id="@+id/rentNowBtn1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    android:text="Rent Now"
                    android:textSize="17sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint1"
                    app:layout_constraintTop_toBottomOf="@id/carDetails1"
                    app:layout_constraintEnd_toStartOf="@id/detailsBtn1"
                    app:layout_constraintBottom_toBottomOf="@id/carcardConstraint1"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/CarCard2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="5dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/CarCard1"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
            android:paddingVertical="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/carcardConstraint2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/carImage2"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/xuv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/carTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="Mahindra XUV700"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint2"
                    app:layout_constraintTop_toBottomOf="@id/carImage2"
                    />

                <TextView
                    android:id="@+id/carDetails2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="10dp"
                    android:text="Petrol/Diesel  |  Automatic  |  5-Seater"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/carTitle2" />

                <TextView
                    android:id="@+id/detailsBtn2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    android:text="Details"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:background="@drawable/button_bg"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint2"
                    app:layout_constraintTop_toBottomOf="@id/carDetails2"
                    app:layout_constraintStart_toEndOf="@id/rentNowBtn2"
                    />

                <TextView
                    android:id="@+id/rentNowBtn2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    android:text="Rent Now"
                    android:textSize="17sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint2"
                    app:layout_constraintTop_toBottomOf="@id/carDetails2"
                    app:layout_constraintEnd_toStartOf="@id/detailsBtn2"
                    app:layout_constraintBottom_toBottomOf="@id/carcardConstraint2"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/CarCard3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="5dp"
            app:cardCornerRadius="10dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/CarCard2"
            app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
            android:background="@color/grey">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/carcardConstraint3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                >

                <ImageView
                    android:id="@+id/carImage3"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_marginHorizontal="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bmw_ix1"
                    android:elevation="10dp"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint3"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint3"
                    app:layout_constraintTop_toTopOf="@id/carcardConstraint3"
                    />

                <TextView
                    android:id="@+id/carTitle3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:text="BMW iX1 LWB"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint3"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint3"
                    app:layout_constraintTop_toBottomOf="@id/carImage3" />

                <TextView
                    android:id="@+id/carDetails3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="10dp"
                    android:text="Electric  |  Automatic  |  5-Seater"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="17sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/carTitle3" />

                <TextView
                    android:id="@+id/detailsBtn3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    android:text="Details"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:background="@drawable/button_bg"
                    app:layout_constraintEnd_toEndOf="@id/carcardConstraint3"
                    app:layout_constraintTop_toBottomOf="@id/carDetails3"
                    app:layout_constraintStart_toEndOf="@id/rentNowBtn3"
                    />

                <TextView
                    android:id="@+id/rentNowBtn3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    android:text="Rent Now"
                    android:textSize="17sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg"
                    app:layout_constraintStart_toStartOf="@id/carcardConstraint3"
                    app:layout_constraintTop_toBottomOf="@id/carDetails3"
                    app:layout_constraintEnd_toStartOf="@id/detailsBtn3"
                    app:layout_constraintBottom_toBottomOf="@id/carcardConstraint3"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <View
            android:id="@+id/bottomLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/CarCard3"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="© 2025 RentHub. All Rights Reserved."
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottomLine"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>



