<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".login_page"
    android:background="@color/white">



    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95"/>

    <ImageView
        android:id="@+id/image_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintDimensionRatio="1:0.85"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/beemer_tp" />

    <!-- Username Field -->

    <!-- Password Field -->

    <TextView
        android:id="@+id/login_app_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="235dp"
        android:text="Rent Hub"
        android:textAlignment="center"
        android:textSize="100sp"
        android:textColor="@color/black"
        android:fontFamily="@font/loversquarrelregular"
        app:layout_constraintDimensionRatio="4:1.7"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="parent"
         />

    <EditText
        android:id="@+id/login_username"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/input_background"
        android:drawableStart="@drawable/baseline_person_24"
        android:inputType="textEmailAddress"
        android:hint="  Enter Username"
        android:padding="12dp"
        android:textSize="12sp"
        app:layout_constraintDimensionRatio="5.8:1"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
        app:layout_constraintTop_toBottomOf="@id/login_app_title" />

    <EditText
        android:id="@+id/login_password"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inputType="textPassword"
        android:hint=" Enter Password"
        android:padding="12dp"
        android:background="@drawable/input_background"
        android:textSize="12sp"
        android:drawableStart="@drawable/baseline_lock_24"
        app:layout_constraintDimensionRatio="5.8:1"
        app:layout_constraintTop_toBottomOf="@id/login_username"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Forgot Password -->

    <!-- Sign Up Option -->
    <Button
        android:id="@+id/login_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="100dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/button_bg"
        android:text="LOGIN"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textAlignment="center"
        android:gravity="center_vertical"
        app:layout_constraintDimensionRatio="5.4:1.3"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
        app:layout_constraintTop_toBottomOf="@id/login_password" />

    <Button
        android:id="@+id/forgot_password"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="34dp"
        android:text="Forgot password?"
        android:gravity="end"
        android:textSize="8sp"
        android:textColor="@color/black"
        android:textAllCaps="false"
        android:background="@drawable/redirectbuttons_bg"
        app:layout_constraintTop_toBottomOf="@id/login_password"
        app:layout_constraintDimensionRatio="12:1"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
         />

    <Button
        android:id="@+id/signup_redirect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:text="Don't have an account? Sign Up!"
        android:textSize="8sp"
        android:textColor="@color/black"
        android:textAllCaps="false"
        android:background="@drawable/redirectbuttons_bg"
        app:layout_constraintDimensionRatio="12:1"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_end"
        app:layout_constraintStart_toStartOf="@id/vertical_guideline_start"
        app:layout_constraintTop_toBottomOf="@id/login_button" />

    <!-- Social Login (Optional)
    <LinearLayout
        android:id="@+id/login_socialimg_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/login_signup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_google"
            android:layout_marginEnd="16dp"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_facebook"/>
    </LinearLayout> -->


</androidx.constraintlayout.widget.ConstraintLayout>