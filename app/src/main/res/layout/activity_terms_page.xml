<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Terms_Page">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/Back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="center"
            android:src="@drawable/baseline_arrow_back_24"
            android:background="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/termsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/poppinsextrabold"
            android:text="Terms and Conditions"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/termsPageHomeButton"
            app:layout_constraintStart_toEndOf="@id/Back"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/termsPageHomeButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/baseline_home_filled_24"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/introduction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="10dp"
            android:text="Welcome to Rent Hub!\n\nThese Terms and Conditions govern your use of our mobile application and services. By accessing or using Rent Hub, you agree to comply with these terms. If you do not agree, please do not use our services."
            android:textSize="20sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/black"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/termsHeader"/>

        <TextView
            android:id="@+id/eligibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="10dp"
            android:text="ELIGIBILTY"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/introduction"/>

        <TextView
            android:id="@+id/eligibilityTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:text="To use Rent Hub, you must:\n\nBe at least 18 years old (or the legal age in your region).\nProvide accurate and complete information during registration.\nUse the platform for lawful purposes only."
            android:textSize="18sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/black"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eligibility"/>

        <TextView
            android:id="@+id/userResponsibilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="10dp"
            android:text="USER RESPONSIBILITIES"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eligibilityTerms"/>

        <TextView
            android:id="@+id/userTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:text="By using Rent Hub, you agree that:\n\nYou will not engage in fraudulent activities.\nYou will respect other users and service providers.\nYou are responsible for verifying the legitimacy of listings before making any payments.\nRent Hub is not liable for any disputes between users and rental providers."
            android:textSize="18sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/black"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/userResponsibilities"/>

        <TextView
            android:id="@+id/accTermination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="10dp"
            android:text="ACCOUNT SUSPENSION and TERMINATION"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/userTerms"/>

        <TextView
            android:id="@+id/accTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:text="We reserve the right to suspend or terminate your account if:\n\nYou violate any terms of this agreement.\nFraudulent or suspicious activity is detected.\nYou engage in harmful or illegal behavior."
            android:textSize="20sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/black"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accTermination"/>

        <TextView
            android:id="@+id/liability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="10dp"
            android:text="LIABILITIES"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accTerms"/>

        <TextView
            android:id="@+id/liabilityTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:text="Rent Hub is an intermediary platform and is not responsible for:\n\nLosses, damages, or injuries resulting from rentals.\nService disruptions due to technical issues or third-party actions."
            android:textSize="20sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/black"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/liability"/>

        <TextView
            android:id="@+id/modification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="10dp"
            android:text="MODIFICATION OF TERMS"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/liabilityTerms"/>

        <TextView
            android:id="@+id/modificationTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:text="We may update these Terms and Conditions at any time. Continued use of the app after changes means you accept the revised terms."
            android:textSize="20sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/black"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/modification"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>


