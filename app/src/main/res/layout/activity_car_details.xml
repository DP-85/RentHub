<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Car_Details"
    android:background="@color/grey">

    <androidx.cardview.widget.CardView
        android:id="@+id/car_detail_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_back_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/loversquarrelregular"
                android:paddingHorizontal="10dp"
                android:text="Rent Hub"
                android:textColor="@color/black"
                android:textSize="45sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toStartOf="@+id/detailsHomeRedirect"
                app:layout_constraintStart_toEndOf="@+id/backButton"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/detailsHomeRedirect"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:src="@drawable/baseline_home_filled_24"
                android:background="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/carImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="-2dp"
        android:background="@color/white"
        android:paddingHorizontal="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/baseline_car_rental_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/car_detail_bar"/>

    <TextView
        android:id="@+id/carName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingStart="30dp"
        android:text="TextView"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/poppinsbold"
        android:background="@drawable/car_detailcard_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carImage" />

    <TextView
        android:id="@+id/specs_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppinsbold"
        android:paddingStart="15dp"
        android:text="SPECS"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carName" />

    <androidx.cardview.widget.CardView
        android:id="@+id/specsContainer1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/specs_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="10dp"
            android:background="@color/grey">

            <TextView
                android:id="@+id/car_detail_engine"
                android:layout_width="105dp"
                android:layout_height="50dp"
                android:background="@drawable/car_detailspec_bg"
                android:drawableStart="@drawable/iconsengine24"
                android:drawableTint="@color/lightblack"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Engine\n2938 cc"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/car_detail_seating"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <TextView
                android:id="@+id/car_detail_seating"
                android:layout_width="105dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/car_detailspec_bg"
                android:drawableStart="@drawable/baseline_airline_seat_recline_extra_24"
                android:drawableTint="@color/lightblack"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Seating\n5 Seater"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/car_detail_engine"
                app:layout_constraintEnd_toStartOf="@id/car_detail_speed"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/car_detail_speed"
                android:layout_width="105dp"
                android:layout_height="50dp"
                android:background="@drawable/car_detailspec_bg"
                android:drawableStart="@drawable/baseline_speed_24"
                android:drawableTint="@color/lightblack"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Max Speed\n207 km/h"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/car_detail_seating"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/specsContainer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/specsContainer1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="10dp"
            android:background="@color/grey">

            <TextView
                android:id="@+id/car_detail_transmission"
                android:layout_width="123dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/car_detailspec_bg"
                android:drawableStart="@drawable/baseline_gear_24"
                android:drawableTint="@color/lightblack"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Transmission\nAutomatic"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/car_detail_fuelType"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/car_detail_fuelType"
                android:layout_width="123dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/car_detailspec_bg"
                android:drawableStart="@drawable/baseline_fuel_24"
                android:drawableTint="@color/lightblack"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Fuel Type\nPetrol"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/car_detail_transmission"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/contract_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:text="CONTRACTS"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/poppinsbold"
        app:layout_constraintTop_toBottomOf="@id/specsContainer2"/>

    <HorizontalScrollView
        android:id="@+id/fuelTypeScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contract_header">

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/contract_header">

            <RadioButton
                android:id="@+id/petrolButton"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Petrol"
                android:textSize="15sp"
                android:textAlignment="center"
                android:background="@drawable/car_detailspec_bg"
                android:textColor="@color/black"
                android:fontFamily="@font/poppinsregular"
                android:button="@null"
                />

            <RadioButton
                android:id="@+id/dieselButton"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="Diesel"
                android:textSize="15sp"
                android:textAlignment="center"
                android:background="@drawable/car_detailspec_bg"
                android:textColor="@color/black"
                android:button="@null"
                android:paddingVertical="10dp"
                android:fontFamily="@font/poppinsregular"/>

            <RadioButton
                android:id="@+id/hybridButton"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="Hybrid"
                android:textSize="15sp"
                android:textAlignment="center"
                android:background="@drawable/car_detailspec_bg"
                android:textColor="@color/black"
                android:button="@null"
                android:paddingVertical="10dp"
                android:fontFamily="@font/poppinsregular"/>
        </RadioGroup>

    </HorizontalScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/plan1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:background="@drawable/rentplans_default_background"
        app:layout_constraintTop_toBottomOf="@id/fuelTypeScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/plan2"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="horizontal"> <!-- Define a border in drawable -->

            <ImageView
                android:id="@+id/clock1"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_lock_clock_24"
                app:tint="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/perDayPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" None\n Day"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppinsregular"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/plan2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:background="@drawable/rentplans_default_background"
        app:layout_constraintTop_toBottomOf="@id/fuelTypeScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/plan1"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/clock2"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_lock_clock_24"
                app:tint="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/perWeekPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" None\n Week"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppinsregular"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/plan3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_goneMarginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:background="@drawable/rentplans_default_background"
        app:layout_constraintTop_toBottomOf="@id/plan1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/plan4"
        android:layout_marginTop="12dp"
        app:layout_constraintHorizontal_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="horizontal"
            > <!-- Define a border in drawable -->

            <ImageView
                android:id="@+id/clock3"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_lock_clock_24"
                app:tint="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/perMonthPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" None\n Month"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppinsregular"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Second Plan -->
    <androidx.cardview.widget.CardView
        android:id="@+id/plan4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:background="@drawable/rentplans_default_background"
        app:layout_constraintTop_toBottomOf="@id/plan2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/plan3"
        android:layout_marginTop="12dp"
        app:layout_constraintHorizontal_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/clock4"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_lock_clock_24"
                app:tint="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/customPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Custom\n Plan"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppinsregular"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/pickupButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:text="pickup"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@drawable/brands_btn_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<!-- 
    ORIGINAL MEASUREMENTS 
    
    SPECS CONTAINER1: 119, 60
    SPECS CONTAINER2: 135, 60
    CARD LAYOUT TEXT: 15SP
-->



