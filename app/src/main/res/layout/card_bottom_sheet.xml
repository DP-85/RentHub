<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    app:cardCornerRadius="15dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardConstraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey"
        >

        <EditText
            android:id="@+id/cardDetailsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:background="@color/blue"
            android:text="ENTER YOUR CARD DETAILS"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/cardConstraint"
            app:layout_constraintStart_toStartOf="@id/cardConstraint"
            app:layout_constraintTop_toTopOf="@id/cardConstraint" />

        <EditText
            android:id="@+id/cardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:paddingVertical="12dp"
            android:paddingStart="20dp"
            android:background="@drawable/input_background"
            android:hint="Enter card number"
            android:inputType="number"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="@id/cardConstraint"
            app:layout_constraintStart_toStartOf="@id/cardConstraint"
            app:layout_constraintTop_toBottomOf="@id/cardDetailsHeader"/>

        <EditText
            android:id="@+id/cardExpriry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="45dp"
            android:background="@drawable/input_background"
            android:hint="Card Expriry"
            android:inputType="text"
            android:textSize="17sp"
            app:layout_constraintStart_toStartOf="@id/cardConstraint"
            app:layout_constraintTop_toBottomOf="@id/cardNumber"/>

        <EditText
            android:id="@+id/cardCVV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="45dp"
            android:background="@drawable/input_background"
            android:hint="Card CVV"
            android:inputType="number"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="@id/cardConstraint"
            app:layout_constraintTop_toBottomOf="@id/cardNumber"/>

        <EditText
            android:id="@+id/cardHolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:paddingVertical="12dp"
            android:paddingStart="20dp"
            android:background="@drawable/input_background"
            android:hint="Enter card holder's name"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="@id/cardConstraint"
            app:layout_constraintStart_toStartOf="@id/cardConstraint"
            app:layout_constraintTop_toBottomOf="@id/cardExpriry"/>

        <Button
            android:id="@+id/payNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
           android:layout_marginVertical="20dp"
            android:background="@drawable/button_bg"
            android:text="Pay using Card"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/cardConstraint"
            app:layout_constraintStart_toStartOf="@id/cardConstraint"
            app:layout_constraintTop_toBottomOf="@id/cardHolderName" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

